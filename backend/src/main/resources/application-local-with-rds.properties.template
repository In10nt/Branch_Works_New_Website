# Local Development with AWS RDS MySQL Database - TEMPLATE
# 
# INSTRUCTIONS:
# 1. Copy this file and rename to: application-local-with-rds.properties
# 2. Replace [YOUR-RDS-ENDPOINT] with your actual RDS endpoint
# 3. Replace [YOUR-RDS-PASSWORD] with your actual RDS password
# 4. Save the file (it's in .gitignore, won't be committed)
# 5. Run: start-backend-with-rds.bat

# Server Configuration
server.port=5000

# Database Configuration (AWS RDS MySQL)
# Get these values from AWS RDS Console after creating your database
spring.datasource.url=jdbc:mysql://[YOUR-RDS-ENDPOINT]:3306/branchworks
spring.datasource.username=admin
spring.datasource.password=[YOUR-RDS-PASSWORD]
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# Example:
# spring.datasource.url=jdbc:mysql://branchworks-db.c9abc123xyz.us-east-1.rds.amazonaws.com:3306/branchworks
# spring.datasource.password=MySecurePassword123!

# JPA Configuration
spring.jpa.database-platform=org.hibernate.dialect.MySQLDialect
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

# Disable H2 Console
spring.h2.console.enabled=false

# File Upload Configuration
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB
file.upload.dir=./src/main/resources/static/uploads

# CORS Configuration (allow localhost for development)
cors.allowed.origins=http://localhost:3000,http://localhost:3001

# Logging
logging.level.com.branchworks=DEBUG
logging.level.org.springframework=INFO
logging.level.org.hibernate=INFO

# Email Configuration
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=nuwangimahesha@gmail.com
spring.mail.password=mqkgwnkismtltjmy
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
spring.mail.properties.mail.smtp.starttls.required=true
spring.mail.properties.mail.smtp.ssl.trust=smtp.gmail.com
spring.mail.test-connection=false

# Company Email
company.email=info@branchworksglobal.com
